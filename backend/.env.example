# GhostTerminal AI - Backend Environment Configuration

# Ollama runtime settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120

# Backend server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Default spirit persona: spectre, daemon, lovelace, void
DEFAULT_PERSONA=spectre

# Demo mode (true enables deterministic offline responses when Ollama is unavailable)
DEMO_MODE=true
